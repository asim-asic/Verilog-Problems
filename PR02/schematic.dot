digraph "circuit" {
label="circuit";
rankdir="LR";
remincross=true;
n3 [ shape=octagon, label="A", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="B", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="C", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="D", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="E", color="black", fontcolor="black" ];
n8 [ shape=diamond, label="Fbar", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="Z", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="w1", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="w2", color="black", fontcolor="black" ];
c13 [ shape=record, label="{{<p3> A|<p4> B}|$6\n$and|{<p12> Y}}",  ];
c14 [ shape=record, label="{{<p3> A|<p4> B}|$1\n$and|{<p12> Y}}",  ];
c15 [ shape=record, label="{{<p3> A|<p4> B}|$2\n$and|{<p12> Y}}",  ];
c16 [ shape=record, label="{{<p3> A}|$4\n$not|{<p12> Y}}",  ];
c17 [ shape=record, label="{{<p3> A|<p4> B}|$5\n$or|{<p12> Y}}",  ];
c18 [ shape=record, label="{{<p3> A|<p4> B}|$3\n$or|{<p12> Y}}",  ];
c19 [ shape=record, label="{{<p3> A|<p4> B}|$9\n$xor|{<p12> Y}}",  ];
c14:p12:e -> c15:p3:w [color="black", fontcolor="black", label=""];
c15:p12:e -> n10:w [color="black", fontcolor="black", label=""];
n10:e -> c17:p3:w [color="black", fontcolor="black", label=""];
c16:p12:e -> n11:w [color="black", fontcolor="black", label=""];
n11:e -> c13:p4:w [color="black", fontcolor="black", label=""];
c18:p12:e -> c16:p3:w [color="black", fontcolor="black", label=""];
n3:e -> c13:p3:w [color="black", fontcolor="black", label=""];
n3:e -> c14:p3:w [color="black", fontcolor="black", label=""];
n4:e -> c14:p4:w [color="black", fontcolor="black", label=""];
n4:e -> c18:p3:w [color="black", fontcolor="black", label=""];
n5:e -> c15:p4:w [color="black", fontcolor="black", label=""];
n5:e -> c18:p4:w [color="black", fontcolor="black", label=""];
n6:e -> c17:p4:w [color="black", fontcolor="black", label=""];
c17:p12:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> c19:p3:w [color="black", fontcolor="black", label=""];
c13:p12:e -> n8:w [color="black", fontcolor="black", label=""];
n8:e -> c19:p4:w [color="black", fontcolor="black", label=""];
c19:p12:e -> n9:w [color="black", fontcolor="black", label=""];
}
